#pragma kernel HiZDown

RWTexture2D<float> _HiZSrc;
RWTexture2D<float> _HiZDst;

cbuffer uniforms14
{
    float4 _child0;
    float4 _child1;
    float4 _child2;
};

float LoadSrc(int2 px)
{
    int2 maxPx = int2((int)_child0.x, (int)_child0.y) - 1;
    px = clamp(px, int2(0, 0), maxPx);
    return _HiZSrc[uint2(px)];
}

[numthreads(8, 8, 1)]
void HiZDown(uint3 id : SV_DispatchThreadID)
{
    uint2 gid = id.xy;
    uint2 dstSize = (uint2)_child1.xy;
    if (gid.x >= dstSize.x || gid.y >= dstSize.y)
        return;

    int2 base = int2(gid << 1);
    float d = LoadSrc(base);
    d = max(d, LoadSrc(base + int2(0, 1)));
    d = max(d, LoadSrc(base + int2(1, 0)));
    d = max(d, LoadSrc(base + int2(1, 1)));

    uint srcW = (uint)_child0.x;
    uint srcH = (uint)_child0.y;
    if (srcW & 1u)
    {
        d = max(d, LoadSrc(base + int2(2, 0)));
        d = max(d, LoadSrc(base + int2(2, 1)));
    }
    if (srcH & 1u)
    {
        d = max(d, LoadSrc(base + int2(0, 2)));
        d = max(d, LoadSrc(base + int2(1, 2)));
    }
    if ((srcW & 1u) && (srcH & 1u))
        d = max(d, LoadSrc(base + int2(2, 2)));

    _HiZDst[gid] = d;
}
