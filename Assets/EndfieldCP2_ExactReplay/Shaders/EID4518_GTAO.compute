#pragma kernel GTAO

Texture2D<float4> _OctNormal;
Texture2D<float> _LinDepth0;
Texture2D<float> _LinDepth1;
Texture2D<float> _LinDepth2;
Texture2D<float> _LinDepth3;
Texture2D<float> _LinDepth4;
RWTexture2D<float> _GTAO;
RWTexture2D<float> _GTAOEdge;

cbuffer uniforms5
{
    float4 _u5[82];
};

cbuffer uniforms10
{
    float4 _u10_0;
    float4 _u10_1;
    float4 _u10_2;
    float4 _u10_3;
    float4 _u10_4;
};

uint HilbertIndex(uint posX, uint posY)
{
    uint index = 0u;
    [unroll]
    for (uint level = 32u; level > 0u; level >>= 1u)
    {
        uint regionX = (posX & level) != 0u ? 1u : 0u;
        uint regionY = (posY & level) != 0u ? 1u : 0u;
        index += level * level * ((3u * regionX) ^ regionY);
        if (regionY == 0u)
        {
            if (regionX == 1u)
            {
                posX = 63u - posX;
                posY = 63u - posY;
            }
            uint tmp = posX;
            posX = posY;
            posY = tmp;
        }
    }
    return index;
}

float3 OctDecode(float2 packed)
{
    float2 e = packed * 2.0 - 1.0;
    float3 n = float3(e.x, 1.0 - abs(e.x) - abs(e.y), e.y);
    if (n.y < 0.0)
    {
        float2 sgn = float2(n.x >= 0.0 ? 1.0 : -1.0, n.z >= 0.0 ? 1.0 : -1.0);
        n.xz = (1.0 - abs(n.zx)) * sgn;
    }
    return normalize(n);
}

float3 WorldToViewDir(float3 nWS)
{
    float3 c0 = float3(_u5[0].x, _u5[1].x, _u5[2].x);
    float3 c1 = float3(_u5[0].y, _u5[1].y, _u5[2].y);
    float3 c2 = float3(_u5[0].z, _u5[1].z, _u5[2].z);
    float3 nVS = float3(dot(nWS, c0), dot(nWS, c1), dot(nWS, c2));
    nVS.z = -nVS.z;
    return nVS;
}

float3 ReconstructViewPos(float2 uv, float viewZ)
{
    float2 ndc = uv * 2.0 - 1.0;
    float2 p = float2(ndc.x * _u5[12].x + _u5[15].x,
                      ndc.y * _u5[13].y + _u5[15].y) * viewZ;
    return float3(p.x, -p.y, viewZ);
}

float FastACosAbs(float ax)
{
    float r = 1.5708 - 0.1566 * ax;
    int i = asint(1.0 - ax);
    i = 532487669 + (i >> 1);
    return clamp(r * asfloat(i), 0.0, 3.1416);
}

float FastACos(float x)
{
    float a = FastACosAbs(abs(x));
    return clamp(x >= 0.0 ? a : (3.1416 - a), 0.0, 3.1416);
}

static const uint2 kOctSize = uint2(1366, 768);

static const uint2 kLinSize[5] =
{
    uint2(683, 384),
    uint2(342, 192),
    uint2(171, 96),
    uint2(86, 48),
    uint2(43, 24)
};

float2 LoadOctPx(int2 px)
{
    px = clamp(px, int2(0, 0), int2(kOctSize) - 1);
    return _OctNormal.Load(int3(px, 0)).xy;
}

float2 SampleOct(float2 uv)
{
    float2 size = float2(kOctSize);
    float2 p = uv * size - 0.5;
    int2 i = int2(floor(p));
    float2 f = frac(p);
    float2 n00 = LoadOctPx(i);
    float2 n10 = LoadOctPx(i + int2(1, 0));
    float2 n01 = LoadOctPx(i + int2(0, 1));
    float2 n11 = LoadOctPx(i + int2(1, 1));
    return lerp(lerp(n00, n10, f.x), lerp(n01, n11, f.x), f.y);
}

float LoadMipPx(uint mip, int2 px)
{
    float z = 0.0;
    if (mip == 0u)
    {
        px = clamp(px, int2(0, 0), int2(kLinSize[0]) - 1);
        z = _LinDepth0.Load(int3(px, 0));
    }
    else if (mip == 1u)
    {
        px = clamp(px, int2(0, 0), int2(kLinSize[1]) - 1);
        z = _LinDepth1.Load(int3(px, 0));
    }
    else if (mip == 2u)
    {
        px = clamp(px, int2(0, 0), int2(kLinSize[2]) - 1);
        z = _LinDepth2.Load(int3(px, 0));
    }
    else if (mip == 3u)
    {
        px = clamp(px, int2(0, 0), int2(kLinSize[3]) - 1);
        z = _LinDepth3.Load(int3(px, 0));
    }
    else
    {
        px = clamp(px, int2(0, 0), int2(kLinSize[4]) - 1);
        z = _LinDepth4.Load(int3(px, 0));
    }
    return z;
}

float SampleMip(float2 uv, uint mip)
{
    float2 size = float2(kLinSize[mip]);
    float2 p = uv * size - 0.5;
    int2 i = int2(floor(p));
    float2 f = frac(p);
    float z00 = LoadMipPx(mip, i);
    float z10 = LoadMipPx(mip, i + int2(1, 0));
    float z01 = LoadMipPx(mip, i + int2(0, 1));
    float z11 = LoadMipPx(mip, i + int2(1, 1));
    return lerp(lerp(z00, z10, f.x), lerp(z01, z11, f.x), f.y);
}

float SampleLinLod(float2 uv, float lod)
{
    lod = clamp(lod, 0.0, 4.0);
    uint i = (uint)lod;
    float f = lod - (float)i;
    float a = SampleMip(uv, i);
    float b = SampleMip(uv, min(i + 1u, 4u));
    return lerp(a, b, f);
}

[numthreads(8, 8, 1)]
void GTAO(uint3 id : SV_DispatchThreadID)
{
    uint2 gid = id.xy;
    uint2 dstSize = (uint2)_u10_4.xy;
    if (gid.x >= dstSize.x || gid.y >= dstSize.y)
        return;

    float2 pixelSize = _u10_4.zw;
    float2 uv = (float2(gid) + 0.5) * pixelSize;
    float viewZ = LoadMipPx(0u, int2(gid));

    float zL = LoadMipPx(0u, int2(gid) + int2(-1, 0));
    float zR = LoadMipPx(0u, int2(gid) + int2(1, 0));
    float zU = LoadMipPx(0u, int2(gid) + int2(0, -1));
    float zD = LoadMipPx(0u, int2(gid) + int2(0, 1));
    float4 deltaZ = float4(zL, zR, zU, zD) - viewZ;
    float4 adjZ = float4(0.5 * (deltaZ.x + deltaZ.y), 0.5 * (deltaZ.x + deltaZ.y),
                         0.5 * (deltaZ.z + deltaZ.w), 0.5 * (deltaZ.z + deltaZ.w));
    float4 edgeAbs = min(abs(deltaZ), abs(adjZ));
    float4 edge = saturate(1.25 - edgeAbs / max(viewZ * 0.011, 1e-8));
    float4 edgeQ = round(edge * 2.9);
    _GTAOEdge[gid] = dot(edgeQ, float4(0.2510, 0.0627, 0.0157, 0.0039));

    float3 nVS = WorldToViewDir(OctDecode(SampleOct(uv)));
    float3 posVS = ReconstructViewPos(uv, viewZ);
    float3 viewVec = normalize(-posVS);

    float effectRadius = _u10_0.x * _u10_0.y;
    float effectFalloffRange = _u10_0.z;
    float distPow = _u10_0.w;
    float thinZ = 1.0 + _u10_1.x;
    float finalPower = _u10_1.y;
    uint hilbertSeed = (uint)_u10_1.z;
    float lodBias = _u10_1.w;
    float nMips = _u10_3.x;

    float3 posNext = ReconstructViewPos(uv + pixelSize, viewZ);
    float deltaViewX = posNext.x - posVS.x;
    float screenspaceRadius = min(effectRadius / max(deltaViewX, 1e-8), 48.0);
    float radiusWS = screenspaceRadius * deltaViewX;
    float falloffRange = effectFalloffRange * radiusWS;
    float falloffFrom = radiusWS * (1.0 - effectFalloffRange);
    float falloffMul = -1.0 / max(falloffRange, 1e-8);
    float falloffAdd = falloffFrom / max(falloffRange, 1e-8) + 1.0;
    float minS = 1.3 / max(screenspaceRadius, 1e-8);

    uint hilbert = HilbertIndex(gid.x, gid.y) + 288u * (hilbertSeed % 64u);
    float2 noise = frac(0.5 + float2(0.7548776662, 0.5698402964) * (float)hilbert);

    float visibility = saturate((10.0 - screenspaceRadius) * 0.01) * 0.5;

    [loop]
    for (uint slice = 0u; slice < 2u; slice++)
    {
        float phi = ((float)slice + noise.x) * 1.5708;
        float sinPhi;
        float cosPhi;
        sincos(phi, sinPhi, cosPhi);
        float2 omega = float2(cosPhi, sinPhi) * screenspaceRadius;

        float3 directionV = float3(cosPhi, sinPhi, 0.0);
        float3 ortho = directionV - viewVec * dot(directionV, viewVec);
        float3 axisV = normalize(cross(ortho, viewVec));
        float3 projN = nVS - axisV * dot(nVS, axisV);
        float projLen = length(projN);
        float sgn = sign(dot(ortho, projN));
        float cosN = saturate(dot(projN, viewVec) / max(projLen, 1e-8));
        float n = sgn * FastACosAbs(abs(cosN));
        float low0 = cos(n + 1.5708);
        float low1 = cos(n - 1.5708);
        float hCos0 = low0;
        float hCos1 = low1;

        [unroll]
        for (uint s = 0u; s < 2u; s++)
        {
            float stepNoise = frac(noise.y + ((float)slice + (float)s * 2.0) * 0.6180339887);
            float t = pow(((float)s + stepNoise) * 0.5, distPow) + minS;
            float2 offsetPx = omega * t;
            float lod = clamp(log2(max(length(offsetPx), 1e-8)) - lodBias, 0.0, max(nMips - 1.0, 0.0));
            float2 offsetUV = round(offsetPx) * pixelSize;

            float2 uv0 = uv + offsetUV;
            float2 uv1 = uv - offsetUV;
            float z0 = SampleLinLod(uv0, lod);
            float z1 = SampleLinLod(uv1, lod);
            float3 p0 = ReconstructViewPos(uv0, z0);
            float3 p1 = ReconstructViewPos(uv1, z1);
            float3 d0 = p0 - posVS;
            float3 d1 = p1 - posVS;
            float dist0 = length(d0);
            float dist1 = length(d1);
            float3 dir0 = d0 / max(dist0, 1e-8);
            float3 dir1 = d1 / max(dist1, 1e-8);
            float w0 = saturate(length(float3(d0.x, d0.y, d0.z * thinZ)) * falloffMul + falloffAdd);
            float w1 = saturate(length(float3(d1.x, d1.y, d1.z * thinZ)) * falloffMul + falloffAdd);
            hCos0 = max(hCos0, lerp(low0, dot(dir0, viewVec), w0));
            hCos1 = max(hCos1, lerp(low1, dot(dir1, viewVec), w1));
        }

        float projW = lerp(projLen, 1.0, 0.05);
        float h0 = FastACos(hCos1);
        float h1 = FastACos(hCos0);
        float sn = sin(n);
        float vis = 0.25 * (
            (cosN - 2.0 * h0 * sn - cos(-2.0 * h0 - n)) +
            (cosN + 2.0 * h1 * sn - cos(2.0 * h1 - n)));
        visibility += projW * vis;
    }

    float ao = abs(visibility * 0.5);
    ao = pow(ao, finalPower);
    ao = saturate(max(ao, 0.03) * 0.6667);
    _GTAO[gid] = ao;
}
