#pragma kernel CSMain

Texture2D<float4> _SrcLo;
SamplerState sampler_SrcLo;
Texture2D<float4> _SrcHi;
RWTexture2D<float4> _Dst;

cbuffer CP3Upsample12
{
    float4 _12_m0;
    float4 _12_m1;
    float4 _12_m2;
};

float2 NMin(float2 a, float2 b)
{
    bool2 nanA = isnan(a);
    bool2 nanB = isnan(b);
    float2 m = min(a, b);
    return float2(nanB.x ? a.x : (nanA.x ? b.x : m.x), nanB.y ? a.y : (nanA.y ? b.y : m.y));
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    float2 pixel = float2(id.xy);
    float2 hiCoord = clamp(float2(uint2(pixel)), 0.0, _12_m2.xy - 1.0);
    float3 hi = _SrcHi.Load(int3(int(hiCoord.x), int(hiCoord.y), 0)).xyz;
    float2 uvCap = 1.0 - _12_m2.zw;
    float2 tap = (((pixel + 0.5) * _12_m2.zw) * _12_m1.xy) + 0.5;
    float2 cell = floor(tap);
    float2 f = frac(tap);
    float2 w0 = 0.16666667163372039794921875 + (f * ((-0.5) + (f * (0.5 - (f * 0.16666667163372039794921875)))));
    float2 halfF = f * 0.5;
    float2 w2base = (f * ((-1.0) + halfF)) * f;
    float2 w2 = 0.666666686534881591796875 + w2base;
    float2 w3 = 0.16666667163372039794921875 + (f * (0.5 + (f * (0.5 - halfF))));
    float2 w1 = ((0.333333313465118408203125 - w2base) - w3) - w0;
    float2 s0 = w0 + w2;
    float2 s1 = w3 + w1;
    float2 o0 = (-1.0) + (w2 * (1.0 / s0));
    float2 o1 = 1.0 + (w1 * (1.0 / s1));
    float2 uv00 = NMin((cell + o0 - 0.5) * _12_m1.zw, uvCap);
    float2 uv10 = NMin((cell + float2(o1.x, o0.y) - 0.5) * _12_m1.zw, uvCap);
    float2 uv01 = NMin((cell + float2(o0.x, o1.y) - 0.5) * _12_m1.zw, uvCap);
    float2 uv11 = NMin((cell + o1 - 0.5) * _12_m1.zw, uvCap);
    float4 lo = (((_SrcLo.SampleLevel(sampler_SrcLo, uv00, 0.0) * s0.x) + (_SrcLo.SampleLevel(sampler_SrcLo, uv10, 0.0) * s1.x)) * s0.y)
              + (((_SrcLo.SampleLevel(sampler_SrcLo, uv01, 0.0) * s0.x) + (_SrcLo.SampleLevel(sampler_SrcLo, uv11, 0.0) * s1.x)) * s1.y);
    uint2 limit = uint2(_12_m2.xy);
    float inside = all(bool2(id.x <= limit.x, id.y <= limit.y)) ? 1.0 : 0.0;
    _Dst[id.xy] = float4(lerp(hi, lo.xyz, _12_m0.xxx) * inside, 1.0);
}
